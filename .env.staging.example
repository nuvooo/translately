# Staging Environment Configuration
NODE_ENV=staging
PORT=4000

# Database (separate staging database!)
DATABASE_URL=mongodb://translately:staging_secret@staging-db:27017/translately_staging?authSource=admin
REDIS_URL=redis://staging-redis:6379

# Auth
# REQUIRED: set a random secret of at least 32 characters, e.g. the output of:
# openssl rand -hex 32 (with NODE_ENV=production the backend refuses to start
# without one; tokens cannot be signed without it)
JWT_SECRET=
JWT_EXPIRY=7d
RESET_TOKEN_EXPIRY_HOURS=1

# CORS (staging domains only)
CORS_ORIGINS=https://staging.translately.de

# Frontend
VITE_API_URL=https://api-staging.translately.de/api
FRONTEND_URL=https://staging.translately.de

# Email (use mailtrap or similar for staging)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging_user
SMTP_PASS=staging_pass
SMTP_FROM="Translately Staging <noreply@staging.translately.de>"
SMTP_SECURE=false
