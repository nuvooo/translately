# Backend Configuration
NODE_ENV=development
PORT=4000
# Backend run on your machine against the MongoDB of docker-compose.yml
# (published on 127.0.0.1:27017, no authentication, replica set rs0).
# directConnection=true talks to that one node instead of discovering the
# replica set, whose member is advertised as mongodb:27017 and only resolves
# inside Docker. Containers use mongodb://mongodb:27017/translately?replicaSet=rs0
# (set in docker-compose.yml, not read from here).
DATABASE_URL=mongodb://127.0.0.1:27017/translately?directConnection=true
REDIS_URL=redis://localhost:6379
# REQUIRED: docker compose refuses to start while this is empty. Set a random
# secret of at least 32 characters, e.g. the output of: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=7d
RESET_TOKEN_EXPIRY_HOURS=1

# Security
# Bearer token for GET /metrics (Prometheus). Unset = disabled in production.
METRICS_TOKEN=
# Swagger UI at /api/swagger is disabled in production unless set to true
ENABLE_SWAGGER=false
# Demo reset endpoint (POST /api/setup/reset-demo). Demo instances only!
ENABLE_DEMO_RESET=false
# First-run setup (POST /api/setup). When set, the setup form asks for this
# token, so only the operator can claim a fresh instance. Recommended for
# publicly reachable deployments. Generate with: openssl rand -hex 32
SETUP_TOKEN=
# Skip `prisma db push` on container start (schema/index sync). Only set this
# if you sync the schema yourself.
SKIP_DB_PUSH=false
# Per-IP limit per minute for the public delivery routes (/sdk/translations/...)
SDK_RATE_LIMIT_PER_MINUTE=600

# Webhooks
# Allow webhook targets in private networks, loopback and link-local ranges
# (SSRF protection). Only enable for receivers in your own trusted network.
WEBHOOK_ALLOW_PRIVATE=false
# Allow plain http:// webhook URLs (default: https only)
WEBHOOK_ALLOW_INSECURE=false
# Disable the webhook delivery worker on this instance (deliveries are queued
# in the database and sent by instances where the worker runs)
WEBHOOK_WORKER_DISABLED=false

# CORS Configuration (comma-separated list of allowed origins)
# For local development:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# For production with separate domains:
# CORS_ORIGINS=https://app.translately.de,https://translately.de,https://api.translately.de

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
# Read by the backend from its environment. docker-compose.yml does not pass
# these to the backend container; add them there if you need mail.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_FROM="Translately <noreply@translately.com>"
SMTP_SECURE=false

# AI translation (optional)
# Without ANTHROPIC_API_KEY the feature is off and nothing is sent anywhere.
# With a key, key names, descriptions and source texts are sent to Anthropic.
ANTHROPIC_API_KEY=
# AI_TRANSLATION_MODEL=claude-haiku-5-5

# For Production Setup (Coolify): see docs/COOLIFY.md. Apps load their texts
# from <origin>/sdk/translations/... where <origin> is the dashboard's address
# (its nginx forwards /sdk/ to the backend) or the backend's own domain.
