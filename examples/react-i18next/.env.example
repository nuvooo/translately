# Copy to .env and restart `npm run dev` after every change.

# Delivery URL of the project, with the {{lng}} and {{ns}}
# placeholders. This one points at the seed project on a local stack.
VITE_LOAD_PATH=http://localhost:4000/sdk/translations/demo-project/{{lng}}/{{ns}}

# The same with the texts of a brand (Multi-brand projects only):
# VITE_LOAD_PATH=http://localhost:4000/sdk/translations/demo-project/{{lng}}/{{ns}}?brandKey=premium

# API key of the project's organization (Organization -> API keys).
VITE_API_KEY=<YOUR_API_KEY>

# Languages of the switcher, comma-separated. The first one is the start and
# fallback language. Default: de,en
# VITE_LANGUAGES=de,en
